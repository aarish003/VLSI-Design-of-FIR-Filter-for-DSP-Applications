% -------------------------------------------------------------
% EEG Noise Removal Using FIR Filter
% Project: VLSI Design of FIR Filter for Biomedical DSP Applications
% -------------------------------------------------------------

clc;
clear;
close all;

% Sampling parameters
fs = 256;                % Sampling frequency (Hz)
t  = 0:1/fs:5;           % Time vector (5 seconds)

% -------------------------------------------------------------
% Generate EEG-like signal (Alpha rhythm ~10 Hz)
% -------------------------------------------------------------
eeg_signal = sin(2*pi*10*t);

% -------------------------------------------------------------
% Add Noise (Power line + random noise)
% -------------------------------------------------------------
powerline_noise = 0.5*sin(2*pi*50*t);   % 50 Hz interference
random_noise    = 0.3*randn(size(t));   % Random noise

noisy_eeg = eeg_signal + powerline_noise + random_noise;

% -------------------------------------------------------------
% FIR Low-Pass Filter Design
% -------------------------------------------------------------
Fc = 30;                 % Cut-off frequency (Hz)
N  = 16;                 % FIR filter order

fir_coeff = fir1(N, Fc/(fs/2));

% -------------------------------------------------------------
% Apply FIR Filter
% -------------------------------------------------------------
filtered_eeg = filter(fir_coeff, 1, noisy_eeg);

% -------------------------------------------------------------
% Plot Results
% -------------------------------------------------------------
figure('Name','EEG Noise Removal Using FIR Filter','NumberTitle','off');

subplot(3,1,1);
plot(t, eeg_signal, 'b');
title('Original EEG Signal');
xlabel('Time (s)');
ylabel('Amplitude');
grid on;

subplot(3,1,2);
plot(t, noisy_eeg, 'r');
title('Noisy EEG Signal');
xlabel('Time (s)');
ylabel('Amplitude');
grid on;

subplot(3,1,3);
plot(t, filtered_eeg, 'g');
title('Filtered EEG Signal (FIR)');
xlabel('Time (s)');
ylabel('Amplitude');
grid on;
